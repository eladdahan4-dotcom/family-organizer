{
  "name": "family-organizer",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "export:web": "expo export -p web",
    "typecheck": "tsc --noEmit",
    "test": "jest -c jest.config.js",
    "test:integration": "firebase emulators:exec --only firestore --project demo-family \"jest -c jest.integration.config.js\"",
    "test:ai": "jest -c jest.ai.config.js",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.4",
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "~53.0.20",
    "expo-constants": "~17.1.7",
    "expo-file-system": "~18.1.11",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "~7.1.7",
    "expo-notifications": "~0.31.4",
    "expo-share-intent": "^4.0.0",
    "expo-status-bar": "~2.2.3",
    "firebase": "^12.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@playwright/test": "1.49.1",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "firebase-tools": "^14.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.9",
    "react-test-renderer": "19.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.8.3"
  }
}
